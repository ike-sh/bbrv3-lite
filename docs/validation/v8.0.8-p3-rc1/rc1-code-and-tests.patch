+        "$time_limit" "$elapsed" "$remaining_time" "$reserved_time"
+    printf 'BUDGET_FEASIBILITY_REASON\t%s\nBUDGET_RESERVATION_SEMANTICS\t%s\nBUDGET_PROFILE\t%s\n' \
+        "${reason:-budget-type-not-recorded}" "$semantics" "$profile"
+}
